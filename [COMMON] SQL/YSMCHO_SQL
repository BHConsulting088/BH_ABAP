*&---------------------------------------------------------------------*
*&      Module  EXIT_0100  INPUT
*&---------------------------------------------------------------------*
MODULE EXIT_0100 INPUT.

  CASE OK_CODE.
    WHEN 'EXIT'.
      LEAVE SCREEN.
    WHEN 'CANC'.
      LEAVE TO SCREEN 0.
  ENDCASE.

ENDMODULE.
*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT
*&---------------------------------------------------------------------*
MODULE USER_COMMAND_0100 INPUT.

  CASE OK_CODE.
    WHEN 'BACK' OR 'CANC'.
      LEAVE TO SCREEN 0.
    WHEN 'LEFT'.
      PERFORM RUN USING : GO_ALV_GIRD_L GO_EDIT_L.
    WHEN 'RIGHT'.
      PERFORM RUN USING : GO_ALV_GIRD_R GO_EDIT_R.
    WHEN 'ALL'.
      PERFORM RUN USING : GO_ALV_GIRD_L GO_EDIT_L,
                          GO_ALV_GIRD_R GO_EDIT_R.
  ENDCASE.

ENDMODULE.
