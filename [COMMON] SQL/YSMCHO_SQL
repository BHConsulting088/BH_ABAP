*&---------------------------------------------------------------------*
*&      Form  CREATE_GUI_EDITOR
*&---------------------------------------------------------------------*
FORM CREATE_GUI_EDITOR USING PO_EDIT      TYPE REF TO CL_GUI_ABAPEDIT
                             PO_CONTAINER TYPE REF TO CL_GUI_CONTAINER
                             PO_COMPLETER TYPE REF TO CL_ABAP_PARSER.

  DATA : LT_EDIT TYPE TY_EDIT.

  CREATE OBJECT PO_EDIT
    EXPORTING
      PARENT           = PO_CONTAINER                   " Parent container
      MAX_NUMBER_CHARS = ABAP_EDITOR_MAX_LENGTH.        " Maximum Number of Characters

  CALL METHOD PO_EDIT->SET_TOOLBAR_MODE
    EXPORTING
      TOOLBAR_MODE           = CL_GUI_SOURCEEDIT=>TRUE  " visibility of toolbar; eq 0: OFF ; ne 0: ON
    EXCEPTIONS
      ERROR_CNTL_CALL_METHOD = 1
      INVALID_PARAMETER      = 2
      OTHERS                 = 3.

  IF SY-SUBRC <> 0.
    MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
               WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.

  PO_EDIT->SET_TEXT(
    EXPORTING
      TABLE           = LT_EDIT
    EXCEPTIONS
      ERROR_DP        = 1
      ERROR_DP_CREATE = 2
      ERROR_CODE_PAGE = 3
      OTHERS          = 4
  ).

  IF SY-SUBRC <> 0.
    MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
               WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.

  PO_EDIT->INIT_COMPLETER( ).
  PO_COMPLETER = PO_EDIT->GET_COMPLETER( ).

  SET HANDLER PO_COMPLETER->HANDLE_COMPLETION_REQUEST
            PO_COMPLETER->HANDLE_INSERTION_REQUEST
            PO_COMPLETER->HANDLE_QUICKINFO_REQUEST  FOR PO_EDIT.

  PO_EDIT->REGISTER_EVENT_COMPLETION( ).
  PO_EDIT->REGISTER_EVENT_INSERT_PATTERN( ).
  PO_EDIT->REGISTER_EVENT_QUICK_INFO( ).

  CL_GUI_CONTROL=>SET_FOCUS( CONTROL = PO_EDIT ).

ENDFORM.
*&---------------------------------------------------------------------*
*&      Form  SET_GRID
*&---------------------------------------------------------------------*
FORM SET_GRID USING PO_CONTAINER      TYPE REF TO CL_GUI_CONTAINER
                    PO_ALV_GIRD       TYPE REF TO CL_GUI_ALV_GRID
                    PV_DATA_FIELDNAME TYPE FIELDNAME.

  DATA : LV_WHERE TYPE STRING,
         LV_DATA  TYPE XSTRING,
         LT_EDIT  TYPE TY_EDIT.

  IF EXIST_SAVING_TABLE = ABAP_TRUE.
    LV_WHERE = |{ USER_FIELDNAME } = @SY-UNAME|.
    SELECT SINGLE (PV_DATA_FIELDNAME) FROM (SAVING_TABLE_NAME)
      WHERE (LV_WHERE)
      INTO @LV_DATA.

    IF LV_DATA IS NOT INITIAL.
      CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
        EXPORTING
          BUFFER     = LV_DATA
        TABLES
          BINARY_TAB = LT_EDIT.
    ENDIF.

  ENDIF.

  CREATE OBJECT PO_ALV_GIRD
    EXPORTING
      I_PARENT          = PO_CONTAINER    " Parent Container
    EXCEPTIONS
      ERROR_CNTL_CREATE = 1
      ERROR_CNTL_INIT   = 2
      ERROR_CNTL_LINK   = 3
      ERROR_DP_CREATE   = 4
      OTHERS            = 5.

  IF SY-SUBRC <> 0.
    MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
               WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.

ENDFORM.
