FORM SET_TREE .

  DATA : LT_SAVED_DATA       TYPE TY_SAVED_DATA,
         " Tree Heading 정보
         LO_HIERARCHY_HEADER TYPE TREEV_HHDR,
         " Event Setting을 위한 선언
         LT_EVENT            TYPE CNTL_SIMPLE_EVENTS,
         LS_EVENT            TYPE CNTL_SIMPLE_EVENT.

  " ALV Tree Object 생성
  PERFORM CREATE_OBJECT_FOR_TREE USING GO_CONTAINER_TREE.

  " Tree에 사용될 Field Catalog
