FORM CREATE_OBJECT_FOR_TREE  USING PO_CONTAINER_TREE TYPE REF TO CL_GUI_CONTAINER.

  CREATE OBJECT GO_TREE
    EXPORTING
      PARENT                      = PO_CONTAINER_TREE                         " Parent Container
      NODE_SELECTION_MODE         = CL_GUI_COLUMN_TREE=>NODE_SEL_MODE_SINGLE  " Nodes: Single or Multiple Selection
      ITEM_SELECTION              = 'X'                                       " Can Individual Items be Selected?
      NO_TOOLBAR                  = ' '                                       " NO_TOOLBAR
      NO_HTML_HEADER              = 'X'                                       " NO_HTML_HEADER
    EXCEPTIONS
      CNTL_ERROR                  = 1
      CNTL_SYSTEM_ERROR           = 2
      CREATE_ERROR                = 3
      LIFETIME_ERROR              = 4
      ILLEGAL_NODE_SELECTION_MODE = 5
      FAILED                      = 6
      ILLEGAL_COLUMN_NAME         = 7
      OTHERS                      = 8.

ENDFORM.
