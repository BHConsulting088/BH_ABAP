      IS_HIERARCHY_HEADER = PO_HIERARCHY_HEADER    " Hierarchy Fields
    CHANGING
      IT_OUTTAB           = PT_SAVED_DATA    " Output Table
      IT_FIELDCATALOG     = GT_TREE_FCAT.    " Field Catalog

ENDFORM.
*&---------------------------------------------------------------------*
*&      Form  SET_EVENT_FOR_TREE
*&---------------------------------------------------------------------*
FORM SET_EVENT_FOR_TREE USING PO_TREE TYPE REF TO CL_GUI_ALV_TREE
                     CHANGING PS_EVENT TYPE CNTL_SIMPLE_EVENT
                              PT_EVENT TYPE CNTL_SIMPLE_EVENTS.

  " 더블 클릭 활성화
  PS_EVENT-EVENTID = CL_GUI_COLUMN_TREE=>EVENTID_NODE_DOUBLE_CLICK.
  PS_EVENT-APPL_EVENT = 'X'.
  APPEND PS_EVENT TO PT_EVENT.
  CLEAR : PS_EVENT.

  " 노드를 확장할 때 데이터를 ALV에 로드하는 데 필요한 이벤트
  PS_EVENT-EVENTID = CL_GUI_COLUMN_TREE=>EVENTID_EXPAND_NO_CHILDREN.
  PS_EVENT-APPL_EVENT = 'X'.
  APPEND PS_EVENT TO PT_EVENT.
  CLEAR : PS_EVENT.

  " 이벤트 설정
  CALL METHOD PO_TREE->SET_REGISTERED_EVENTS
    EXPORTING
      EVENTS = PT_EVENT.

  CREATE OBJECT GO_TREE_EVENT.
  SET HANDLER GO_TREE_EVENT->HANDLE_NODE_DOUBLE_CLICK FOR GO_TREE.

ENDFORM.
